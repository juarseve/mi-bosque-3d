  minimumCorrectAnswers: 2
  pointsPerCorrectAnswer: 5
  showSuccessDialogue: 1
  successDialogueTitles:
  - "\xA1Felicidades!"
  - "\xA1Gavil\xE1n Recuperado!"
  successDialogueSentences:
  - "\xA1Excelente trabajo! Has demostrado tu conocimiento sobre las cadenas tr\xF3ficas."
  - "Gracias a tu sabidur\xEDa, el gavil\xE1n ha recuperado sus fuerzas. \xA1Has obtenido
    la Medalla del Gavil\xE1n!"
  successDialogueSprites:
  - {fileID: 0}
  - {fileID: 0}
