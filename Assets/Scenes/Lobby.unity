MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1293594683}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dab8e4113e2e44045a1268b474a2d3f9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  message:
  - "\xA1Hola! soy un Guardabosque y te dar\xE9 algunas indicaciones. \xBFEst\xE1s
    listo?"
  - "Para poder caminar utiliza las teclas: A para ir a la izquierda, D para la derecha,
    S para ir hacia atr\xE1s y W para adelante."
  - "Con las teclas mencionadas podr\xE1s caminar y explorar el Bosque. Ahora practiquemos. "
  - "Debes seguirme y caminar hacia delante para recoger las esferas rojas. \xA1Vamos! "
  - "\xA1Aprendes muy r\xE1pido!, pero \xBFsabes como correr? "
  - "\xBFno lo sabes? pues es algo sencillo, solo debes presionar Shift mientras caminas. "
  - 'Practiquemos nuevamente y recoge las esferas verdes.  No olvides correr usando
    Shift. '
  - "\xA1Buen trabajo! aprendes muy r\xE1pido. "
  - "Ahora probemos saltos. \xA1Mira qu\xE9 divertido! \xBFTe gustar\xEDa aprender? "
  - "Para saltar debes presionar la tecla de Espacios. \xA1Int\xE9ntalo! "
  - "\xA1Muy buen salto! lo has hecho genial. "
  - 'Hemos terminado las indicaciones. '
  - Ahora ya puedes iniciar tu aventura.
  text: {fileID: 1260289093}
  player: {fileID: 0}
  joystick: {fileID: 1908627316}
  button: {fileID: 1620861439}
  sceneButton: {fileID: 1661115779}
  panel: {fileID: 482837168}
  keyboardImage: {fileID: 2006127672}
  keyboardRun: {fileID: 126603590}
  keyboardJump: {fileID: 996714483}
  salto: 0
  bandera: 0
